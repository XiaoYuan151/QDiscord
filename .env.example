DISCORD_TOKEN=replace-with-your-discord-bot-token
DISCORD_PERMISSIONS=ViewChannel,SendMessages,AttachFiles,ReadMessageHistory
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_ACCESS_TOKEN=

# Comma/newline separated pairs: discordChannelId:qqGroupId[:both|discord-to-qq|qq-to-discord]
BRIDGE_PAIRS=123456789012345678:987654321

# Optional mention mappings.
# QQ -> Discord for QQ [CQ:at] rendering in Discord.
QQ_TO_DISCORD_USER_MAP=123456789:111111111111111111

# Discord -> QQ for Discord user mentions rendering as [CQ:at].
DISCORD_TO_QQ_USER_MAP=111111111111111111:123456789

# Optional face/emote mappings. Values can be Unicode emoji or Discord custom emoji.
# QQ face id -> Discord emoji text
CQ_FACE_EMOJI_MAP=14:<:qq_smile:222222222222222222>

# Discord emoji id/name -> QQ face id
DISCORD_EMOJI_CQ_FACE_MAP=222222222222222222:14,qq_smile:14

SHOW_SENDER_NAME=true
BRIDGE_BOT_MESSAGES=false
ALLOW_EVERYONE_MENTIONS=false
BRIDGE_MEMBER_EVENTS=true
BRIDGE_TYPING_INDICATORS=true
UPLOAD_QQ_FILES=true
RESOLVE_QQ_MEDIA_URLS=true

# Optional safety filters. Leave empty to disable.
ALLOWED_DISCORD_GUILD_IDS=
ALLOWED_DISCORD_CHANNEL_IDS=
ALLOWED_QQ_GROUP_IDS=
BLOCKED_DISCORD_USER_IDS=
BLOCKED_QQ_USER_IDS=

# Discord slash command: /bridge status
STATUS_COMMAND_ENABLED=true
STATUS_COMMAND_NAME=bridge
# Optional comma/newline separated guild IDs for immediate guild-scoped registration.
STATUS_COMMAND_GUILD_IDS=
# Optional Discord user IDs allowed to run /bridge status without Manage Server.
STATUS_COMMAND_ALLOWED_USER_IDS=

# Message splitting limits.
DISCORD_MAX_CONTENT_LENGTH=1900
QQ_MAX_TEXT_SEGMENT_LENGTH=3500

# NapCat OneBot connection and action timing.
NAPCAT_RECONNECT_INITIAL_MS=1000
NAPCAT_RECONNECT_MAX_MS=30000
NAPCAT_RECONNECT_JITTER_MS=0
NAPCAT_HEARTBEAT_INTERVAL_MS=30000
NAPCAT_HEARTBEAT_TIMEOUT_MS=10000
ONEBOT_ACTION_TIMEOUT_MS=15000

# Outbound queue and retry controls.
QUEUE_CONCURRENCY=1
QUEUE_MAX_PENDING=1000
QUEUE_MIN_DELAY_MS=250
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_BASE_DELAY_MS=1000
SHUTDOWN_DRAIN_TIMEOUT_MS=10000

# In-memory reply/delete mapping retention.
MESSAGE_LINK_TTL_MS=86400000
MESSAGE_LINK_MAX_ENTRIES=10000
MESSAGE_LINK_STORE_PATH=.qdiscord-links.json

# Local health endpoints: /healthz, /readyz, /status
HEALTH_ENABLED=true
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8787
HEALTH_STATUS_TOKEN=

LOG_LEVEL=info
